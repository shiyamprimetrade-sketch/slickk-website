# Static rendering supports an email-draft fallback; secure V4 intake requires runtime bindings.
# For deployment, prefer Wrangler OAuth. Never commit API tokens.
# V4 public build settings (these are not secrets). Enable only with verified runtime bindings.
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFpSucD7-7Bc1qU9
PUBLIC_TRACKING_ENABLED=true
# Runtime TURNSTILE_SECRET and LEADS_ADMIN_TOKEN belong in Cloudflare encrypted secrets only.
# INQUIRIES_DB is the Pages D1 binding; EVENTS_ENABLED=true enables consent-based counters.
# GEMINI_API_KEY belongs in a Cloudflare encrypted secret, never this file or Git.
# Runtime controls: GEMINI_SHOWCASE_ENABLED=true, GEMINI_MODEL=gemini-3.5-flash-lite,
# MAX_AI_REQUESTS_PER_DAY=20. The D1 ai_usage_daily migration is required first.
