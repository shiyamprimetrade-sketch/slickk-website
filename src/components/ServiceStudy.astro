---
interface Props { slug: string; }
const { slug } = Astro.props;
type Study = { kind: string; title: string; caption: string; steps: string[]; review: string };
const studies: Record<string, Study> = {
  identity: { kind: 'identity', title: 'One idea. A recognizable system.', caption: 'Fictional identity exploration for an independent studio.', steps: ['Distinctive mark', 'Color roles', 'Consistent applications'], review: 'Check the mark at small sizes and in one color. Agree the font license, spacing rules and export formats before handover.' },
  document: { kind: 'document', title: 'Give every page a purpose.', caption: 'Illustrative four-page document architecture; content is a placeholder.', steps: ['Introduce the business', 'Explain the offer', 'Support it with facts', 'Make contact easy'], review: 'Confirm every claim and image permission. Review reading order, page count, print margins and a readable digital PDF before approval.' },
  web: { kind: 'web', title: 'A clear route from question to inquiry.', caption: 'Responsive page structure study, not a live customer website.', steps: ['Understand the offer', 'Explore relevant detail', 'Take the next step'], review: 'Test keyboard navigation, real phone widths, loading behavior and form errors. A prominent button is useful only when the destination works.' },
  software: { kind: 'software', title: 'Make the next action visible.', caption: 'Sample workflow states; no real customer or operational records.', steps: ['New request', 'Assigned owner', 'Review', 'Complete'], review: 'Define permissions and valid state changes. Keep a record of important changes and provide a recovery path when a request fails.' },
  mobile: { kind: 'mobile', title: 'A small workflow, designed for a small screen.', caption: 'Mobile task-flow sketch; not a published app or an offline capability claim.', steps: ['Choose a task', 'Review the details', 'Confirm the action'], review: 'Agree device coverage and connectivity requirements. Test touch targets, screen readers, loading, errors and interrupted sessions on the target devices.' },
  search: { kind: 'search', title: 'Connect a real question to a useful page.', caption: 'Illustrative intent map, not search-volume data or a ranking forecast.', steps: ['Customer question', 'Relevant service page', 'Helpful internal link', 'Verified measurement'], review: 'Confirm crawlability, page purpose and factual content first. Track implemented changes separately from indexing, clicks and inquiries.' },
  campaign: { kind: 'campaign', title: 'One message. A considered sequence.', caption: 'Original campaign planning sketch; no spend, reach or conversion results.', steps: ['Audience need', 'Useful message', 'Relevant destination', 'Review evidence'], review: 'Agree the objective and measurement source before publishing. Separate media spend, creative production and management responsibilities.' },
  automation: { kind: 'automation', title: 'Automate the routine. Keep an accountable checkpoint.', caption: 'Illustrative workflow design; no AI service runs in this demonstration.', steps: ['Receive input', 'Validate & draft', 'Human review', 'Approved action'], review: 'Uncertain or invalid output returns to review. Define data permissions, costs, evaluation cases and a manual fallback before connecting a live system.' },
};
const categories: Record<string, string> = { 'branding-graphic-design':'identity', 'logo-design':'identity', 'brand-identity':'identity', 'graphic-design':'identity', 'brochure-design':'document', 'company-profile-design':'document', 'content-creation':'document', 'web-development':'web', 'website-development':'web', 'software-development':'software', 'app-development':'mobile', 'seo':'search', 'seo-services':'search', 'digital-marketing':'campaign', 'ai-automation':'automation' };
const study = studies[categories[slug] ?? 'web'];
---
<section class="service-study container" aria-labelledby="study-title">
  <header><p class="eyebrow">Inside the work / illustrative study</p><h2 id="study-title">{study.title}</h2><p>{study.caption}</p></header>
  <div class:list={['study-surface', study.kind]}>
    {study.kind === 'identity' && <div class="identity-board"><div class="mark-tile"><span class="study-mark" aria-hidden="true">n.</span><span>FORM STUDY / 01</span></div><div class="type-tile"><span>Fictional studio</span><strong>New perspective.</strong><div class="swatches"><span>Ink</span><span>Paper</span><span>Accent</span></div></div></div>}
    {study.kind === 'document' && <div class="document-spread">{['01 / Introduction','02 / Capabilities','03 / Evidence','04 / Contact'].map((label,i)=><div class="paper"><span>{label}</span><strong>{['A clear beginning.','What we do.','Facts with context.','A useful next step.'][i]}</strong><div class="paper-lines" aria-hidden="true"></div></div>)}</div>}
    {study.kind === 'web' && <div class="web-frame"><div class="frame-top"><span>YOUR BUSINESS</span><span>Offer · About · Contact</span></div><div class="web-body"><span>THE CUSTOMER QUESTION</span><strong>Make the offer clear.</strong><p>Who it helps. What it solves. What to do next.</p><span class="sample-action">Inquiry destination →</span></div><div class="web-proof"><span>Relevant detail</span><span>Credible evidence</span><span>Clear contact route</span></div></div>}
    {study.kind === 'software' && <div class="workflow-board">{['To review','In progress','Ready to close'].map((label,i)=><div class="workflow-column"><span>{label}</span><div class="task-card"><small>SAMPLE TASK / 0{i+1}</small><strong>{['Review the brief','Prepare the draft','Confirm acceptance'][i]}</strong><span>Owner assigned · next step defined</span></div></div>)}</div>}
    {study.kind === 'mobile' && <div class="mobile-flow">{['Choose','Review','Confirm'].map((label,i)=><div class="phone"><small>STEP 0{i+1}</small><strong>{label}</strong><div class="phone-content">{['Select the request you want to make.','Check the details before continuing.','Show a clear status and next step.'][i]}</div><span class="phone-footer">{['Task list','Review summary','Confirmation state'][i]}</span></div>)}</div>}
    {study.kind === 'search' && <div class="search-map"><div><span>QUESTION</span><strong>“What should my company website include?”</strong></div><span class="map-connector" aria-hidden="true">↓</span><div><span>PAGE PURPOSE</span><strong>Website planning guide</strong><p>Answer the question, then link to a relevant service.</p></div><span class="map-connector" aria-hidden="true">↓</span><div><span>NEXT STEP</span><strong>Website service → project brief</strong></div></div>}
    {study.kind === 'campaign' && <div class="campaign-board">{['A useful idea.','The supporting detail.','A clear invitation.'].map((label,i)=><div class="campaign-tile"><span>MESSAGE 0{i+1}</span><strong>{label}</strong><span>{['Introduce the problem','Explain a practical benefit','Link to the relevant offer'][i]}</span></div>)}</div>}
    {study.kind === 'automation' && <div class="automation-board"><div class="automation-route"><span>Input</span><span aria-hidden="true">→</span><span>Draft</span><span aria-hidden="true">→</span><strong>Human approval</strong><span aria-hidden="true">→</span><span>Action</span></div><p class="review-path">Needs correction? Return to review before anything is sent or changed.</p><div class="guardrails"><span>Access boundaries</span><span>Failure handling</span><span>Manual fallback</span></div></div>}
  </div>
  <ol class="study-steps">{study.steps.map((step,i)=><li><span aria-hidden="true">0{i+1}</span>{step}</li>)}</ol>
  <details class="study-review"><summary>What we would check before handover</summary><p>{study.review}</p></details>
</section>
<style>
.service-study{padding-block:2rem 4rem}.service-study header{max-width:48rem;margin-bottom:1.5rem}.service-study h2{font-size:clamp(1.8rem,4vw,3rem);line-height:1.15;text-wrap:balance}.service-study header>p:last-child{color:var(--muted,#bbb8ca)}.study-surface{padding:clamp(1rem,4vw,3rem);border:1px solid #455468;border-radius:4px;background:#111720;color:#f5f3ef;overflow:hidden}.study-surface strong{font-weight:650}.identity-board{display:grid;grid-template-columns:1fr 1.5fr;gap:1rem}.mark-tile{display:grid;place-items:center;background:#4bd7ef;color:#080b10;min-height:230px;padding:1rem;border-radius:4px}.study-mark{font-size:8rem;font-weight:800;line-height:1;letter-spacing:-.1em}.mark-tile>span:last-child,.type-tile>span,.study-surface small{font-size:.7rem;letter-spacing:.12em}.type-tile{display:flex;flex-direction:column;justify-content:center;gap:1.5rem;padding:1rem}.type-tile>strong{font-size:clamp(2rem,5vw,4rem);line-height:1.05}.swatches{display:flex;flex-wrap:wrap;gap:.5rem}.swatches span{padding:1.2rem .8rem;border:1px solid #788899;border-radius:4px}.swatches span:nth-child(2){background:#f5f3ef;color:#222934}.swatches span:nth-child(3){background:#4bd7ef;color:#222934}.document-spread{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.paper{aspect-ratio:3/4;background:#f5f3ef;color:#222934;padding:1rem;display:flex;flex-direction:column;gap:1.4rem;border-radius:.2rem}.paper>span{font-size:.7rem}.paper strong{font-size:clamp(1rem,2vw,1.6rem);line-height:1.2}.paper-lines{margin-top:auto;height:3rem;background:repeating-linear-gradient(to bottom,#8c8492 0px,#8c8492 2px,transparent 2px,transparent 10px);opacity:.6}.web-frame{background:#f5f3ef;color:#222934;border-radius:4px;overflow:hidden}.frame-top,.web-proof{display:flex;justify-content:space-between;gap:1rem;padding:1rem;border-bottom:1px solid #cec6d5;font-size:.75rem;flex-wrap:wrap}.web-body{padding:clamp(1rem,4vw,3rem);max-width:44rem}.web-body>span:first-child{font-size:.7rem;letter-spacing:.1em}.web-body>strong{display:block;font-size:clamp(1.8rem,4vw,3rem);line-height:1.1;margin-block:1rem}.sample-action{display:inline-block;padding:.7rem 1rem;background:#0e5187;color:#fff;border-radius:4px;font-size:.85rem}.web-proof{border-top:1px solid #cec6d5;border-bottom:0}.workflow-board,.mobile-flow,.campaign-board{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.workflow-column{padding:1rem;background:#211c2e;border-radius:4px}.workflow-column>span{font-size:.8rem}.task-card{display:grid;gap:1rem;margin-top:1rem;padding:1rem;background:#eee8f5;color:#222934;border-radius:4px}.task-card>span{font-size:.75rem}.phone{border:2px solid #8a7f9a;padding:1.5rem 1rem;border-radius:4px;display:flex;flex-direction:column;gap:1.5rem;min-height:260px}.phone>strong{font-size:1.5rem}.phone-content{font-size:.9rem}.phone-footer{margin-top:auto;border-top:1px solid #62596e;padding-top:1rem;font-size:.75rem}.search-map{max-width:40rem;margin-inline:auto}.search-map>div{background:#272032;padding:1rem 1.4rem;border-left:3px solid #c9adea;border-radius:4px}.search-map strong{display:block;margin-top:.5rem}.search-map div>span{font-size:.7rem;letter-spacing:.12em}.search-map p{margin-bottom:0;font-size:.9rem}.map-connector{display:block;text-align:center;font-size:1.5rem;padding:.25rem}.campaign-tile{display:flex;flex-direction:column;gap:2rem;padding:1.5rem;border-radius:4px;background:#4bd7ef;color:#222934;min-height:230px}.campaign-tile:nth-child(2){background:#eee8df}.campaign-tile:nth-child(3){background:#c4d8cf}.campaign-tile strong{font-size:clamp(1.5rem,3vw,2.3rem);line-height:1.15}.campaign-tile span{font-size:.75rem}.campaign-tile>span:last-child{margin-top:auto}.automation-route{display:flex;align-items:center;justify-content:center;gap:1rem;flex-wrap:wrap}.automation-route>span:not([aria-hidden]),.automation-route>strong{padding:1rem;background:#30263f;border:1px solid #78658e;border-radius:.6rem}.automation-route>strong{background:#4bd7ef;color:#222934}.review-path{text-align:center;padding:1.2rem;border-bottom:1px dashed #8b7b9c}.guardrails{display:flex;justify-content:center;gap:1rem;flex-wrap:wrap;font-size:.85rem}.study-steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:1rem;list-style:none;padding:1.5rem 0;margin:0}.study-steps li{display:flex;align-items:baseline;gap:.6rem;font-size:.9rem}.study-steps li>span{font-size:.7rem;color:#c9adea}.study-review{border-top:1px solid #455468;border-bottom:1px solid #455468;padding:1rem 0}.study-review summary{cursor:pointer;font-weight:600;padding:.3rem;min-height:44px;align-content:center}.study-review summary:focus-visible{outline:2px solid #4bd7ef;outline-offset:4px;border-radius:.2rem}.study-review p{max-width:65ch;padding-inline:.3rem;line-height:1.7}.study-surface *{min-width:0;overflow-wrap:break-word}@media(max-width:680px){.identity-board,.workflow-board,.campaign-board{grid-template-columns:1fr}.mark-tile{min-height:180px}.document-spread{grid-template-columns:repeat(2,1fr)}.mobile-flow{grid-template-columns:1fr}.phone{min-height:auto;gap:1rem}.phone-content{max-width:35ch}.automation-route{flex-direction:column}.automation-route>span[aria-hidden]{transform:rotate(90deg)}.campaign-tile{min-height:180px}.type-tile{padding-block:1rem}.study-steps{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
