---
import { products } from '../data/site';
interface Props { filterable?: boolean; }
const { filterable = false } = Astro.props;
---
{filterable && <div class="product-filters" role="group" aria-label="Filter products" hidden><button type="button" data-filter="all" aria-pressed="true">All fruit</button>{products.map((product) => <button type="button" data-filter={product.id} aria-pressed="false">{product.short}</button>)}</div>}
<div class="product-grid" id="product-results">
  {products.map((product) => <article class={`product-card ${product.color}`} data-product={product.id}>
    <a href={`/products/#${product.id}`} class="product-image"><img src={`/images/${product.id}.webp`} srcset={`/images/${product.id}-small.webp 480w, /images/${product.id}.webp 800w`} sizes="(max-width: 640px) 100vw, 33vw" width="800" height="640" alt={`Explore ${product.short.toLowerCase()} — illustrative fruit photography`} loading="lazy" decoding="async" /><span class="product-number" aria-hidden="true">{product.number}</span><span class="product-arrow" aria-hidden="true">↗</span></a>
    <div class="product-card-copy"><p class="eyebrow">HS {product.hs}</p><h3><a href={`/products/#${product.id}`}>{product.name}</a></h3><p>{product.description}</p><a class="text-link" href={`/contact/?product=${product.id}`}>Make an inquiry <span aria-hidden="true">↗</span></a></div>
  </article>)}
</div>
{filterable && <p class="small filter-status" aria-live="polite" id="filter-status">Showing all 3 fruit categories.</p>}
<script>
  const filters = document.querySelector<HTMLElement>('.product-filters');
  if (filters) {
    filters.hidden = false;
    const buttons = filters.querySelectorAll<HTMLButtonElement>('button');
    buttons.forEach((button) => button.addEventListener('click', () => {
      const selected = button.dataset.filter;
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      document.querySelectorAll<HTMLElement>('[data-product]').forEach((card) => { card.hidden = selected !== 'all' && card.dataset.product !== selected; });
      const status = document.querySelector('#filter-status');
      if (status) status.textContent = selected === 'all' ? 'Showing all 3 fruit categories.' : `Showing ${button.textContent?.toLowerCase()}.`;
    }));
  }
</script>
