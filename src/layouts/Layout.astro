---
import { brand, mainNavigation } from '../data/agency';
import '../styles/agency.css';
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, brand.url).href;
const socials = Object.entries(brand.social).filter(([, url]) => /^https:\/\//.test(url));
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: brand.name, url: brand.url, email: brand.email,
  description: brand.description,
  areaServed: ['Bangladesh', 'International'],
  ...(socials.length ? { sameAs: socials.map(([, url]) => url) } : {}),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101827" />
    <title>{title} | Slickk</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title + ' | Slickk'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={brand.url + '/agency-social.svg'} />
    <meta property="og:image:alt" content="Slickk — Software. Creativity. Growth." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="masthead">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label="Slickk home">slickk<span>.</span></a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="site-navigation" type="button">Menu ☰</button>
        <nav id="site-navigation" class="primary" aria-label="Main navigation">
          {mainNavigation.map((item) => <a aria-current={Astro.url.pathname === item.href ? 'page' : undefined} href={item.href}>{item.label}</a>)}
          <a class="btn btn-small" href="/contact/">Get a free consultation</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="container">
        <div class="footer-grid">
          <div><a class="logo" href="/">slickk<span>.</span></a><p>{brand.tagline}</p><p>Software development & digital growth services.<br />Based in Bangladesh, welcoming international inquiries.</p><a href={'mailto:' + brand.email}>{brand.email}</a></div>
          <div><h3>Explore</h3>{mainNavigation.map((item) => <a href={item.href}>{item.label}</a>)}<a href="/contact/">Contact</a></div>
          <div><h3>Services & policies</h3><a href="/software-development/">Software</a><a href="/web-development/">Web development</a><a href="/seo-services/">SEO</a><a href="/digital-marketing/">Digital marketing</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/cookies/">Cookies</a></div>
        </div>
        {socials.length > 0 && <div aria-label="Social profiles">{socials.map(([name, href]) => <a href={href} rel="me noopener noreferrer" target="_blank">{name}</a>)}</div>}
        <div class="footer-bottom"><span>© {new Date().getFullYear()} Slickk. All rights reserved.</span><span>Bangladesh · Global inquiries welcome</span></div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#site-navigation');
      function closeMenu() { toggle?.setAttribute('aria-expanded', 'false'); nav?.classList.remove('is-open'); }
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        nav?.classList.toggle('is-open', open);
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle?.focus(); } });
      document.addEventListener('click', (event) => { if (event.target instanceof Node && !nav?.contains(event.target) && !toggle?.contains(event.target)) closeMenu(); });
    </script>
  </body>
</html>
