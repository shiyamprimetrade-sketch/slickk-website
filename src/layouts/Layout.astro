---
import { brand, mainNavigation, services, detailedServices } from '../data/agency';
import '../styles/agency.css';
import '../styles/v4.css';
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const trackingEnabled = import.meta.env.PUBLIC_TRACKING_ENABLED === 'true';
const canonical = new URL(Astro.url.pathname, brand.url).href;
const segments = Astro.url.pathname.split('/').filter(Boolean);
const parentName = segments[0] === 'portfolio' ? 'Portfolio' : 'Services';
const breadcrumbs = { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[
  { '@type':'ListItem', position:1, name:'Home', item:brand.url+'/' },
  ...(segments.length>1 ? [{ '@type':'ListItem', position:2, name:parentName, item:brand.url+'/'+segments[0]+'/' }] : []),
  { '@type':'ListItem', position:segments.length>1?3:2, name:title, item:canonical },
] };
const isService = services.some(service=>Astro.url.pathname==='/'+service.slug+'/') || detailedServices.some(service=>Astro.url.pathname==='/services/'+service.slug+'/');
const serviceSchema = { '@context':'https://schema.org', '@type':'Service', name:title, description, url:canonical, serviceType:title, areaServed:['Bangladesh','International'], provider:{'@type':'Organization',name:brand.name,url:brand.url} };
const socials = Object.entries(brand.social).filter(([, url]) => /^https:\/\//.test(url));
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: brand.name, url: brand.url, email: brand.email,
  description: brand.description,
  areaServed: ['Bangladesh', 'International'],
  ...(socials.length ? { sameAs: socials.map(([, url]) => url) } : {}),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080b14" />
    <title>{title} | Slickk Digital Solutions</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title + ' | Slickk Digital Solutions'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={brand.url + '/images/agency-social.jpg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Slickk Digital Solutions — We Design. We Build. We Elevate." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    {!noindex && segments.length>0 && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />}
    {isService && <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />}
  </head>
  <body data-tracking-enabled={String(trackingEnabled)}>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="masthead">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label="Slickk home">slickk<span>.</span></a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="site-navigation" type="button">Menu ☰</button>
        <nav id="site-navigation" class="primary" aria-label="Main navigation">
          {mainNavigation.map((item) => <a aria-current={Astro.url.pathname === item.href ? 'page' : undefined} href={item.href}>{item.label}</a>)}
          <a class="btn btn-small" href="/contact/">Get a free consultation</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="container">
        <div class="footer-grid">
          <div><a class="logo" href="/">slickk<span>.</span></a><p>{brand.tagline}</p><p>Independent creative technology, led by a solo founder.<br />Based in Bangladesh. International inquiries welcome.</p><Fragment set:html={'<!--email_off--><a href="mailto:contact@slickk.online">contact@slickk.online</a><!--/email_off-->'} /></div>
          <div><h3>Explore</h3>{mainNavigation.map((item) => <a href={item.href}>{item.label}</a>)}<a href="/contact/">Contact</a></div>
          <div><h3>Services & policies</h3><a href="/services/logo-design/">Logo design</a><a href="/services/brochure-design/">Brochures</a><a href="/software-development/">Software</a><a href="/web-development/">Web development</a><a href="/seo-services/">SEO</a><a href="/digital-marketing/">Digital marketing</a><a href="/ai-automation/">AI automation</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/cookies/">Cookies</a></div>
        </div>
        {socials.length > 0 && <div aria-label="Social profiles">{socials.map(([name, href]) => <a href={href} rel="me noopener noreferrer" target="_blank">{name}</a>)}</div>}
        <div class="footer-bottom"><span>© {new Date().getFullYear()} Slickk Digital Solutions. All rights reserved.</span><span>Bangladesh · Global inquiries welcome</span></div>
        {trackingEnabled && <button class="filter-chip" id="analytics-preferences" type="button">Analytics preferences</button>}
      </div>
    </footer>
    {trackingEnabled && <aside class="consent-panel" id="analytics-consent" aria-label="Optional analytics preferences" hidden><h2>Help us understand what is useful.</h2><p>Optional first-party analytics counts page and inquiry actions without visitor identifiers or message content. Your choice is stored on this device. <a href="/cookies/">Read the cookie notice</a>.</p><div class="actions"><button class="btn btn-outline" type="button" data-analytics-choice="no">Necessary only</button><button class="btn" type="button" data-analytics-choice="yes">Allow analytics</button></div></aside>}
    <script>
      import '../scripts/motion';
      import { initAnalytics } from '../scripts/analytics';
      initAnalytics();
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#site-navigation');
      function closeMenu() { toggle?.setAttribute('aria-expanded', 'false'); nav?.classList.remove('is-open'); }
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        nav?.classList.toggle('is-open', open);
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle?.focus(); } });
      document.addEventListener('click', (event) => { if (event.target instanceof Node && !nav?.contains(event.target) && !toggle?.contains(event.target)) closeMenu(); });
    </script>
  </body>
</html>
