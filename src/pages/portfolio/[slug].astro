---
import Layout from '../../layouts/Layout.astro';
import GradientButton from '../../components/GradientButton.astro';
import { portfolioConcepts } from '../../data/agency';
import { relatedServices } from '../../data/v4';
export function getStaticPaths(){return portfolioConcepts.map(concept=>({params:{slug:concept.slug},props:{concept}}));}
const {concept}=Astro.props;
const hasDemo = ['commerce-experience', 'operations-dashboard'].includes(concept.slug);
---
<Layout title={concept.title+' — Demonstration Concept'} description={concept.summary+' This is a clearly identified self-initiated demonstration, not a client commission.'}>
  <section class="page-hero aurora-surface"><div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/portfolio/">Portfolio</a> / {concept.title}</nav>
    <p class="eyebrow">{concept.eyebrow}</p><h1>{concept.title}</h1><p class="lead">{concept.summary}</p>
  </div></section>
  <section class="section container concept-layout"><div class="concept-gallery"><figure><img src={'/images/portfolio/'+concept.slug+'.svg'} width="1200" height="850" alt={concept.title+' — full original concept composition'} fetchpriority="high" /><figcaption>Original self-initiated study. Fictional context; no client attribution or performance claim.</figcaption></figure><button class="btn" type="button" data-open-art aria-haspopup="dialog">View full artwork</button><figure><div class="study-detail"><img src={'/images/portfolio/'+concept.slug+'.svg'} width="1200" height="850" alt="Close view of the same concept composition" loading="lazy" /></div><figcaption>Composition detail from the same study.</figcaption></figure></div>
    <div><p class="eyebrow">The design challenge</p><h2>What this exploration sets out to do.</h2><p>{concept.objective}</p>
      <h3>Design approach</h3><p>A focused visual hierarchy, consistent spacing and a restrained color system organize the work. The composition explores how the proposed information could be presented; it is not evidence of a delivered client engagement.</p>
      <h3>Proposed outputs</h3><ul>{concept.deliverables.map(item=><li>{item}</li>)}</ul>
      <h3>Outcomes and attribution</h3><p>Created as an original Slickk portfolio study. No measured business outcome, client approval, endorsement or commissioned relationship is claimed.</p>
      <a class="text-link" href={'/services/'+relatedServices[concept.slug]+'/'}>Explore the related service →</a>
      <div class="notice">{concept.note} The visual is an original illustrative treatment, not a client-approved work sample.</div>
      <GradientButton href="/contact/">Discuss something similar</GradientButton>
    </div>
  </section>
  <dialog id="artwork-dialog" aria-labelledby="artwork-title">
    <div class="artwork-heading"><h2 id="artwork-title">{concept.title}</h2><button class="btn" type="button" data-close-art autofocus>Close artwork</button></div>
    <img src={'/images/portfolio/'+concept.slug+'.svg'} width="1200" height="850" alt={concept.title+' — full original concept composition'} loading="lazy" />
    <p>Original SLICKK concept. Fictional context; no client endorsement or measured outcome.</p>
  </dialog>
  {hasDemo && <section class="section container" aria-labelledby="responsive-demo-title">
    <p class="eyebrow">Explore the layout</p><h2 id="responsive-demo-title">One idea. Different screen widths.</h2>
    <p>This responsive HTML demonstration uses fictional content. It is not a live shop or business system. Controls change the preview’s maximum width; on a small screen, the preview fits the available space.</p>
    <div class="preview-controls" role="group" aria-label="Preview width">{[['Desktop','1080'],['Tablet','720'],['Mobile','360']].map(([label,width],i)=><button class="btn" type="button" data-preview-width={width} aria-pressed={i===0} aria-controls="responsive-preview">{label}</button>)}</div>
    <div id="responsive-preview" class="responsive-preview">
      <div class="demo-shell">
        <header class="demo-header"><strong>{concept.slug==='commerce-experience'?'FORM / living':'FIELD / operations'}</strong><span>Fictional demo</span></header>
        {concept.slug==='commerce-experience' ? <div class="demo-content">
          <p class="demo-kicker">Objects for everyday rituals</p><h3>Thoughtful essentials.<br />Room to breathe.</h3><p>A sample collection showing how product information adapts to the space available.</p>
          <div class="demo-products">{[['01','Arc lamp','Warm light, clean lines'],['02','Everyday vessel','A simple ceramic form'],['03','Oak tray','A place for small things']].map(([number,name,description])=><article class="demo-product"><div class="demo-object" aria-hidden="true">{number}</div><h4>{name}</h4><p>{description}</p><span>Concept product · not for sale</span></article>)}</div>
        </div> : <div class="demo-content">
          <p class="demo-kicker">Workspace overview</p><h3>A clear view of the next step.</h3><p>Sample records only. No live data, approvals or account actions.</p>
          <div class="demo-metrics"><div><strong>03</strong><span>Sample requests</span></div><div><strong>02</strong><span>Ready for review</span></div><div><strong>01</strong><span>Needs information</span></div></div>
          <div class="demo-work"><section><h4>Request queue</h4><ul class="demo-queue">{[['DEMO-001','Website brief','Ready for review'],['DEMO-002','Identity materials','Needs information'],['DEMO-003','Workflow outline','Ready for review']].map(([id,name,status])=><li><div><small>{id}</small><strong>{name}</strong></div><span>{status}</span></li>)}</ul></section><aside class="demo-note"><h4>Next action</h4><p>Confirm the brief owner and required materials before beginning a project.</p><p>Illustrative workflow guidance, not a live notification.</p></aside></div>
        </div>}
      </div>
    </div>
  </section>}
  <section class="section section-soft"><div class="container"><p class="eyebrow">Continue exploring</p><h2>More creative possibilities</h2><div class="grid cards-3">{portfolioConcepts.filter(p=>p.slug!==concept.slug).slice(0,3).map(p=><article class="card"><p class="card-number">{p.discipline}</p><h3>{p.title}</h3><p>{p.summary}</p><a href={'/portfolio/'+p.slug+'/'}>View concept →</a></article>)}</div></div></section>
</Layout>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#artwork-dialog');
  const opener = document.querySelector<HTMLButtonElement>('[data-open-art]');
  opener?.addEventListener('click', () => dialog?.showModal());
  dialog?.querySelector('[data-close-art]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('close', () => opener?.focus());
  const preview = document.querySelector<HTMLElement>('#responsive-preview');
  const widthButtons = document.querySelectorAll<HTMLButtonElement>('[data-preview-width]');
  widthButtons.forEach(button => button.addEventListener('click', () => {
    if (preview) preview.style.maxWidth = `${button.dataset.previewWidth}px`;
    widthButtons.forEach(candidate => candidate.setAttribute('aria-pressed', String(candidate === button)));
  }));
</script>
<style>
  dialog{width:min(1280px,94vw);max-height:92dvh;margin:auto;padding:clamp(16px,3vw,32px);border:1px solid #737886;border-radius:16px;background:#11141c;color:#f7f7fb;overflow:auto}
  dialog::backdrop{background:rgb(0 0 0 / .85)}
  dialog img{display:block;width:100%;height:auto;max-width:none}
  .artwork-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:20px}.artwork-heading h2{font-size:clamp(1.2rem,3vw,2rem);margin:0}.artwork-heading button{flex-shrink:0}
  .preview-controls{display:flex;flex-wrap:wrap;gap:10px;margin:24px 0}.preview-controls button[aria-pressed=true]{background:#e4c2ff;color:#16101d;border-color:#e4c2ff}.preview-controls button:focus-visible,[data-open-art]:focus-visible,[data-close-art]:focus-visible{outline:3px solid #b9e9ff;outline-offset:4px}
  .responsive-preview{container-type:inline-size;max-width:1080px;width:100%;margin-inline:auto;border:1px solid #505565;border-radius:18px;overflow:hidden}.demo-shell{background:#f6f3ed;color:#202a2c;font-family:Arial,sans-serif}.demo-header{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;padding:24px;border-bottom:1px solid #c6ccc5}.demo-header span{font-size:.8rem}.demo-content{padding:32px}.demo-content h3{font-size:clamp(1.6rem,4cqi,2.8rem);line-height:1.15;letter-spacing:-.035em;color:#202a2c}.demo-content p{color:#445254;max-width:65ch}.demo-kicker{text-transform:uppercase;font-size:.75rem;letter-spacing:.12em}.demo-products,.demo-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:28px}.demo-product{min-width:0}.demo-product h4,.demo-work h4{color:#202a2c;margin:16px 0 8px}.demo-product p{margin:0 0 10px}.demo-product>span{font-size:.75rem;color:#52605d}.demo-object{aspect-ratio:4/3;background:#dfe4d9;display:grid;place-items:center;font-size:3rem;color:#6b7962;border-radius:8px}.demo-product:nth-child(2) .demo-object{background:#eadfd5}.demo-product:nth-child(3) .demo-object{background:#d8e1e4}.demo-metrics>div{padding:20px;background:white;border-radius:8px}.demo-metrics strong,.demo-metrics span{display:block}.demo-metrics strong{font-size:2rem}.demo-metrics span{font-size:.85rem;color:#52605d}.demo-work{display:grid;grid-template-columns:2fr 1fr;gap:24px;margin-top:28px}.demo-queue{list-style:none;padding:0;margin:0}.demo-queue li{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:18px 0;border-bottom:1px solid #c6ccc5}.demo-queue small,.demo-queue strong{display:block}.demo-queue small{color:#52605d}.demo-queue li>span{font-size:.75rem;background:#e2e9db;padding:6px 8px;border-radius:5px}.demo-note{background:#e8e8dd;padding:18px;border-radius:8px}.demo-note p{font-size:.9rem}
  @container (max-width:760px){.demo-products{grid-template-columns:repeat(2,minmax(0,1fr))}.demo-work{grid-template-columns:1fr}.demo-content{padding:24px}}
  @container (max-width:440px){.demo-products,.demo-metrics{grid-template-columns:1fr}.demo-content,.demo-header{padding:18px}.demo-queue li{align-items:flex-start;flex-direction:column}.demo-metrics>div{display:flex;align-items:center;gap:18px}.demo-content h3{font-size:1.7rem}}
  @media(max-width:560px){.artwork-heading{align-items:flex-start;flex-direction:column}}
</style>
