---
import Layout from '../../layouts/Layout.astro';
import GradientButton from '../../components/GradientButton.astro';
import { guides, type Guide } from '../../data/guides';
export function getStaticPaths() {
  return guides.map(guide => ({ params: { slug: guide.slug }, props: { guide } }));
}
interface Props { guide: Guide; }
const { guide } = Astro.props;
---
<Layout title={guide.title} description={guide.description}>
  <section class="page-hero aurora-surface"><div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/insights/">Insights</a> / Guide</nav>
    <p class="eyebrow">A practical SLICKK guide</p>
    <h1>{guide.title}</h1><p class="lead">{guide.intro}</p>
    <p>SLICKK editorial · <time datetime={guide.date}>28 October 2026</time> · {guide.readingTime}</p>
  </div></section>
  <div class="container section editorial">
    <aside><p class="eyebrow">In this guide</p><nav aria-label="Guide sections">{guide.sections.map((section, i) => <a href={'#part-' + (i + 1)}>{section.title}</a>)}</nav><a class="text-link" href="/pricing/">Explore starting packages →</a></aside>
    <article aria-label={guide.title}>
      {guide.sections.map((section, i) => <section id={'part-' + (i + 1)}><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}{section.checklist && <ul>{section.checklist.map(item => <li>{item}</li>)}</ul>}</section>)}
      <div class="notice">Package information reflects SLICKK’s published starting scope on 28 October 2026. Your written proposal confirms the agreed deliverables and price.</div>
      <p><a class="text-link" href="/insights/">← All practical guides</a></p>
    </article>
  </div>
  <section class="section container"><div class="cta"><div><p class="eyebrow">From reading to a useful brief</p><h2>Tell us what you need to build.</h2><p>{guide.serviceName}: share your goal, current materials and timeframe.</p></div><GradientButton href={'/request-quote/?service=' + guide.serviceSlug}>Discuss your project</GradientButton></div></section>
</Layout>
