---
import Layout from '../layouts/Layout.astro';
import ProductCards from '../components/ProductCards.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { products } from '../data/site';
---
<Layout title="Our Products — Apples, Oranges & Grapes" description="Explore SLICKK’s fresh apple, orange and grape sourcing categories, broad HS references, packing considerations and wholesale inquiry options.">
  <section class="page-hero"><div class="container"><p class="eyebrow">Our fresh-fruit portfolio</p><h1>Simple focus.<br /><em>Fresh possibilities.</em></h1><p class="page-intro">Apples, oranges and fresh grapes. Explore the categories at the heart of our international sourcing interests.</p></div></section>
  <section class="section container" aria-label="Product categories"><ProductCards filterable /><p class="small">This is a sourcing guide, not a live inventory. Images are illustrative. Prices, availability and origin require confirmation.</p></section>
  <div class="product-details container">{products.map((product) => <section class="product-detail" id={product.id}><div><p class="eyebrow">{product.number} / HS {product.hs}</p><h2>{product.name}</h2><p class="lead">{product.description}</p><p>{product.detail}</p><a class="button" href={`/contact/?product=${product.id}`}>Inquire about {product.short.toLowerCase()} <span aria-hidden="true">↗</span></a></div><div class="product-facts"><article><h3>Sourcing considerations</h3><p>{product.origin}</p></article><article><h3>Packaging & handling</h3><p>{product.packaging}</p></article><article><h3>Quality & freshness</h3><p>{product.quality}</p></article></div></section>)}</div>
  <p class="container small tariff-note">HS codes are broad product references, not national tariff advice. Confirm detailed classification and current requirements with qualified customs professionals.</p><ContactCTA />
</Layout>
