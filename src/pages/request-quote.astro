---
import Layout from '../layouts/Layout.astro';
import InquiryForm from '../components/InquiryForm.astro';
---
<Layout title="Request a Project Quote" description="Request a scoped quote for Slickk branding, brochures, websites, software or SEO. Share deliverables, budget and timing for Bangladesh or international projects.">
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Request a quote</div><p class="eyebrow">A useful first brief</p><h1>Define the ambition.<br />Let's scope the work.</h1><p class="lead">Tell us the outcome, audience, deliverables and practical constraints. An inquiry starts a discussion; it is not a confirmed project or contract.</p></div></section>
  <InquiryForm quote />
</Layout>
