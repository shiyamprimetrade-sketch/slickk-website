---
import Layout from '../../layouts/Layout.astro';
import GradientButton from '../../components/GradientButton.astro';
import ServiceStudy from '../../components/ServiceStudy.astro';
import { detailedServices } from '../../data/agency';
import { serviceFaqs } from '../../data/v4';
import { guides } from '../../data/guides';
import { parentForDetail } from '../../data/serviceSilos';
export function getStaticPaths() { return detailedServices.map(page=>({params:{slug:page.slug},props:{page}})); }
const {page}=Astro.props;
const relatedGuide = guides.find(guide => guide.serviceSlug === page.slug);
const parentSilo = parentForDetail(page.slug);
---
<Layout title={page.title} description={page.description}>
  <section class="page-hero aurora-surface"><div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/services/">Services</a> / {parentSilo && <><a href={'/' + parentSilo.slug + '/'}>{parentSilo.name}</a> / </>}{page.title}</nav>
    <p class="eyebrow">{page.label}</p><h1>{page.title}</h1><p class="lead">{page.intro}</p>
    <GradientButton href={'/contact/?service='+encodeURIComponent(page.slug)}>Request a quote</GradientButton>
  </div></section>
  <ServiceStudy slug={page.slug} />
  <div class="container section editorial">
    <aside><p class="eyebrow">Explore this service</p><nav aria-label="Page sections">{page.sections.map((part,i)=><a href={'#part-'+(i+1)}>{part.title}</a>)}</nav><a href="/pricing/" class="btn">View launch packages</a></aside>
    <article>{page.sections.map((part,i)=><section id={'part-'+(i+1)}><h2>{part.title}</h2><p>{part.text}</p>{part.items && <ul>{part.items.map(item=><li>{item}</li>)}</ul>}</section>)}
      <div class="notice"><strong>Good to know:</strong> Scope, timelines and delivery capacity are confirmed in writing before work starts. Illustrative concepts are not presented as actual client outcomes.</div>
      {serviceFaqs[page.slug] && <section class="faq service-faq"><h2>Service questions</h2>{serviceFaqs[page.slug].map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}<a class="text-link" href="/portfolio/">Explore our concept work →</a></section>}
      {relatedGuide && <section><h2>Prepare your brief</h2><p>Read our practical guide before asking for a quote.</p><a class="text-link" href={'/insights/' + relatedGuide.slug + '/'}>{relatedGuide.title} →</a></section>}
      {parentSilo && <p>Explore the broader <a class="text-link" href={'/' + parentSilo.slug + '/'}>{parentSilo.name.toLowerCase()} service →</a></p>}
    </article>
  </div>
  <section class="section container"><div class="cta"><div><p class="eyebrow">Your brief</p><h2>Ready to shape the right solution?</h2><p>Tell us the business goal, practical requirements and timeframe.</p></div><GradientButton href="/contact/">Start a project</GradientButton></div></section>
</Layout>
