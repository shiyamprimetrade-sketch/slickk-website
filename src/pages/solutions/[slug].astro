---
import Layout from '../../layouts/Layout.astro';
import { growthSolutions, type GrowthSolution } from '../../data/growthSolutions';
export function getStaticPaths() { return growthSolutions.map(solution=>({params:{slug:solution.slug},props:{solution}})); }
interface Props { solution:GrowthSolution; }
const { solution }=Astro.props;
---
<Layout title={solution.title} description={solution.description}>
  <section class="page-hero"><div class="container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/solutions/">Solutions</a> / {solution.title}</nav><p class="eyebrow">Independent Slickk service</p><h1>{solution.title}</h1><p class="lead">{solution.intro}</p></div></section>
  <div class="section container editorial"><aside><p class="eyebrow">On this page</p><nav aria-label="Page sections">{solution.sections.map((section,i)=><a href={'#section-'+i}>{section.title}</a>)}</nav><a class="text-link" href="/business-tools/">Compare tools</a></aside><article>{solution.sections.map((section,i)=><section id={'section-'+i}><h2>{section.title}</h2>{section.paragraphs.map(paragraph=><p>{paragraph}</p>)}{section.items && <ul>{section.items.map(item=><li>{item}</li>)}</ul>}</section>)}</article></div>
  <section class="section container"><div class="cta"><div><h2>Scope a responsible setup</h2><p>Share your goal and current tools. A written quote separates Slickk's work from vendor fees.</p></div><a class="btn" href={'/request-quote/?service='+solution.service}>Request a quote</a></div></section>
</Layout>
