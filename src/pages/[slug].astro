---
import Layout from '../layouts/Layout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { editorialPages } from '../data/pages';
import { inquiryLink } from '../data/site';
export function getStaticPaths() { return editorialPages.map((page) => ({ params: { slug: page.slug }, props: { page } })); }
const { page } = Astro.props;
const legal = ['privacy', 'terms'].includes(page.slug);
---
<Layout title={`${page.title.replace('\n', ' ')}`} description={page.description}>
  <section class="page-hero"><div class="container"><a class="breadcrumb" href="/">Home <span aria-hidden="true">/</span></a><p class="eyebrow">{page.eyebrow}</p><h1>{page.title.split('\n').map((line) => <span class="line">{line}</span>)}</h1><p class="page-intro">{page.intro}</p></div></section>
  <div class={`container section editorial-layout ${legal ? 'legal-layout' : ''}`}>
    <aside class="contents"><p class="eyebrow">On this page</p><nav aria-label="Page contents">{page.sections.map((section, index) => <a href={`#section-${index + 1}`}>{section.title}</a>)}</nav>{page.cta && <a class="button" href={inquiryLink(`SLICKK — ${page.cta}`)}>{page.cta} <span aria-hidden="true">↗</span></a>}</aside>
    <div class="editorial-copy">{legal && <div class="review-notice"><strong>Draft for owner review</strong><p>Prepared 22 October 2026. The owner must review this notice and confirm actual business practices before publication.</p></div>}{page.sections.map((section, index) => <section id={`section-${index + 1}`}><span class="section-number">{String(index + 1).padStart(2, '0')}</span><h2>{section.title}</h2><p>{section.text}</p>{section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}</section>)}</div>
  </div>
  {!legal && <ContactCTA />}
</Layout>
