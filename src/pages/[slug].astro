---
import Layout from '../layouts/Layout.astro';
import { agencyPages, services, pricing } from '../data/agency';
export function getStaticPaths() { return agencyPages.map((page) => ({ params: { slug: page.slug }, props: { page } })); }
const { page } = Astro.props;
const isPricing = page.slug === 'pricing';
const isServices = page.slug === 'services';
---
<Layout title={page.title} description={page.description}>
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / {page.title}</div><p class="eyebrow">{page.label}</p><h1>{page.title}</h1><p class="lead">{page.intro}</p></div></section>
  <div class="container section editorial">
    <aside><p class="eyebrow">On this page</p><nav aria-label="Page sections">{page.sections.map((part,i) => <a href={'#part-' + (i + 1)}>{part.title}</a>)}</nav>{!page.legal && <a class="btn" href={'/contact/?service=' + encodeURIComponent(page.slug)}>Discuss your project</a>}</aside>
    <article>{page.sections.map((part,i) => <section id={'part-' + (i + 1)}><h2>{part.title}</h2><p>{part.text}</p>{part.items && <ul>{part.items.map((item) => <li>{item}</li>)}</ul>}</section>)}
      {isServices && <div class="grid cards-2">{services.map((service) => <section class="card"><h3>{service.name}</h3><p>{service.description}</p><a href={'/' + service.slug + '/'}>Explore this service →</a></section>)}</div>}
      {isPricing && <div class="grid cards-2">{pricing.map((item) => <section class="card"><h3>{item.name}</h3><div class="price">{item.price}</div><span class="price-period">{item.period}</span><p>{item.description}</p><a href={'/contact/?service=' + encodeURIComponent(item.name)}>Request a quote →</a></section>)}</div>}
      {page.legal && <p class="notice">Initial policy draft, subject to business and legal review. Last prepared 26 October 2026.</p>}
    </article>
  </div>
  {!page.legal && <section class="section container"><div class="cta"><div><h2>Have a project in mind?</h2><p>Tell Slickk about your requirements to explore the next steps.</p></div><a class="btn" href="/contact/">Start an inquiry</a></div></section>}
</Layout>
