---
import Layout from '../layouts/Layout.astro';
import { faqs } from '../data/agency';
---
<Layout title="Frequently Asked Questions" description="Answers about Slickk services, website development, pricing, SEO expectations and project consultations for Bangladesh and international clients.">
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / FAQs</div><p class="eyebrow">Frequently asked questions</p><h1>Clear answers. Better decisions.</h1><p class="lead">Learn how our service inquiries and project quotations work.</p></div></section>
  <section class="section container faq"><h2>What would you like to know?</h2>{faqs.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}<div class="actions"><a href="/contact/" class="btn">Ask us a question</a></div></section>
</Layout>
