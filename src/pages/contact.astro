---
import Layout from '../layouts/Layout.astro';
import { brand, services } from '../data/agency';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const options = [
  { name: 'General inquiry', slug: 'general' },
  ...services.map((s) => ({ name: s.name, slug: s.slug }))
];
---
<Layout title="Contact & Free Project Consultation" description="Contact Slickk for web development, mobile apps, SEO, digital marketing, custom business software and creative services. Email contact@slickk.online.">
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Contact</div><p class="eyebrow">Let's collaborate</p><h1>Tell us what you're building.</h1><p class="lead">A question, a project brief or an idea worth exploring. Share the details to start a conversation.</p></div></section>
  <section class="section container contact-layout">
    <div>
      <p class="eyebrow">Contact Slickk</p>
      <h2>Great ideas begin with a conversation.</h2>
      <p class="muted">Slickk is based in Bangladesh. We welcome inquiries from local and international businesses.</p>
      <p><strong>Email:</strong> <a href={'mailto:' + brand.email}>{brand.email}</a></p>
      <p class="muted">A consultation request is an inquiry, not a confirmed appointment. We will discuss scheduling and availability by email.</p>
      <div class="notice"><strong>How it works</strong><p>Tell us your goals, services needed and budget range. We will use the details to prepare a useful response.</p></div>
      <p class="muted">No verified social or WhatsApp business profile is linked yet.</p>
    </div>
    <div class="contact-form">
      <h2>Project inquiry</h2>
      <p id="form-explanation" class="muted">{siteKey ? 'We will attempt a secure form submission. You will see confirmation only after the server accepts your request.' : 'This form prepares an email draft on your device. You must review and send the message from your email app; it does not automatically reach Slickk.'}</p>
      <form id="project-inquiry" method="post" action="/api/inquiry" hidden data-mode={siteKey ? 'secure' : 'draft'} aria-describedby="form-explanation">
        <div class="form-grid">
          <label class="field">Your name *<input name="name" autocomplete="name" required maxlength="100" /></label>
          <label class="field">Business / company<input name="company" autocomplete="organization" maxlength="140" /></label>
          <label class="field">Email *<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
          <label class="field">Service<select name="service">{options.map((option) => <option value={option.slug}>{option.name}</option>)}</select></label>
          <label class="field full">Estimated budget<select name="budget"><option value="Not specified">Prefer to discuss</option><option value="Under BDT 25000">Under ৳25,000</option><option value="BDT 25000-50000">৳25,000–50,000</option><option value="BDT 50000-100000">৳50,000–100,000</option><option value="BDT 100000+">Over ৳100,000</option></select></label>
          <label class="field full">Tell us about your project *<textarea name="message" rows="6" minlength="20" maxlength="3000" required placeholder="What would you like to build, improve or promote?"></textarea></label>
        </div>
        <label class="field" hidden aria-hidden="true">Leave this blank<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
        <label class="field"><input type="checkbox" name="consent" required /> I have reviewed the <a href="/privacy/">privacy policy</a> and agree to be contacted about my inquiry. *</label>
        {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light"></div>}
        <p class="badge-note">Please avoid sending passwords, API keys, financial details or other sensitive information.</p>
        <button class="btn" type="submit">{siteKey ? 'Send project inquiry' : 'Open email draft'}</button>
        <p class="form-status" id="inquiry-status" role="status" aria-live="polite"></p>
      </form>
      <noscript><p>Email us directly at <a href="mailto:contact@slickk.online">contact@slickk.online</a> because the form requires JavaScript.</p></noscript>
    </div>
  </section>
  {siteKey && <script async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}
  <script>
    const form = document.querySelector<HTMLFormElement>('#project-inquiry');
    const status = document.querySelector<HTMLElement>('#inquiry-status');
    const options = new Set(['general', 'software-development', 'app-development', 'web-development', 'seo-services', 'digital-marketing', 'content-creation']);
    if (form) {
      form.hidden = false;
      const queryService = new URLSearchParams(location.search).get('service') || '';
      const serviceSelect = form.elements.namedItem('service');
      if (serviceSelect instanceof HTMLSelectElement && options.has(queryService)) serviceSelect.value = queryService;
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const data = new FormData(form);
        if (data.get('website')) return;
        const values = Object.fromEntries([...data.entries()].map(([k, v]) => [k, String(v).trim()]));
        if (values.message.length < 20 || values.message.length > 3000 || values.name.length > 100 || !values.consent) { if (status) status.textContent = 'Check your required fields.'; return; }
        if (form.dataset.mode === 'draft') {
          const body = ['Name: ' + values.name, 'Company: ' + (values.company || 'Not provided'), 'Email: ' + values.email, 'Service: ' + values.service, 'Budget: ' + values.budget, '', values.message].join('\n');
          const email = 'mailto:contact@slickk.online?subject=' + encodeURIComponent('Slickk project inquiry — ' + values.service) + '&body=' + encodeURIComponent(body);
          if (status) status.textContent = 'Opening your email app. Review and send the message there. Nothing has been submitted through this site.';
          window.location.href = email;
          return;
        }
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
        if (button) button.disabled = true;
        if (status) status.textContent = 'Submitting your inquiry…';
        try {
          const response = await fetch('/api/inquiry', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(values), credentials: 'same-origin' });
          const result = await response.json();
          if (!response.ok || !result.ok) throw new Error('Submission was not accepted');
          form.reset();
          if (status) status.textContent = 'Your inquiry was accepted by the server. We will contact you by email.';
        } catch {
          if (status) status.textContent = 'The secure form could not send your inquiry. Please email contact@slickk.online directly.';
        } finally { if (button) button.disabled = false; }
      });
    }
  </script>
</Layout>
