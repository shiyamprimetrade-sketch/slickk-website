---
import Layout from '../layouts/Layout.astro';
import ProductCards from '../components/ProductCards.astro';
import SourcingMap from '../components/SourcingMap.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { site, markets } from '../data/site';
---
<Layout title="Freshness Across Borders — Fruit Sourcing Bangladesh" description="SLICKK connects international fresh-fruit sourcing opportunities with Bangladesh. Explore apples, oranges and grapes, and start a B2B inquiry.">
  <section class="hero">
    <div class="hero-copy"><p class="eyebrow"><span class="tiny-leaf" aria-hidden="true"></span>Rooted in purpose. Connected globally.</p><h1>Freshness<br />Across <em>Borders.</em></h1><p class="hero-description">{site.description}</p><div class="button-row"><a class="button button-citrus" href="/products/">Explore our products <span aria-hidden="true">↗</span></a><a class="hero-secondary" href="/contact/">Contact SLICKK <span aria-hidden="true">↗</span></a></div><div class="hero-footnote"><span class="small-caps">A focused portfolio</span><span>Apples <i>·</i> Oranges <i>·</i> Grapes</span></div></div>
    <div class="hero-visual"><img src="/images/hero.webp" srcset="/images/hero-small.webp 768w, /images/hero.webp 1536w" sizes="(max-width: 850px) 100vw, 53vw" alt="Illustrative still life of fresh red apples, oranges and grapes on a deep green background" width="1536" height="1024" fetchpriority="high" /><div class="hero-image-label"><span class="image-label-line"></span>Nature’s finest.<br />A world of possibility.</div><div class="hero-stamp" aria-hidden="true">GLOBAL<br /><span>by nature.</span></div></div>
  </section>
  <div class="origin-strip"><div class="container"><span class="small-caps">Our sourcing focus</span><span>China</span><b aria-hidden="true">✳</b><span>South Africa</span><b aria-hidden="true">✳</b><span>Egypt</span><span class="origin-destination">For Bangladesh <span aria-hidden="true">↗</span></span></div></div>
  <section class="section container"><div class="section-heading"><div><p class="eyebrow">Selected with purpose</p><h2>Three fruits.<br />Endless possibilities.</h2></div><div><p>A focused portfolio, shaped around the needs<br class="desktop-break" /> of the fresh-produce trade.</p><a class="text-link" href="/products/">Discover our products <span aria-hidden="true">↗</span></a></div></div><ProductCards /><p class="small product-disclaimer">Illustrative product imagery. Availability, origin and specifications require individual confirmation.</p></section>
  <section class="about-section section"><div class="container about-grid"><div class="about-art" aria-hidden="true"><span class="art-orbit orbit-one"></span><span class="art-orbit orbit-two"></span><span class="art-orbit orbit-three"></span><span class="art-center">S<span>.</span></span><span class="art-label label-top">GLOBAL PERSPECTIVE</span><span class="art-label label-bottom">LOCAL PURPOSE</span></div><div><p class="eyebrow">The SLICKK perspective</p><h2>A world of freshness.<br />A focus on Bangladesh.</h2><p>SLICKK is an international fresh-fruit sourcing and import-oriented business brand. We bring a focused approach to conversations between overseas fruit exporters and Bangladesh’s wholesale market.</p><p>Our direction is clear: quality-conscious sourcing, transparent communication and relationships built with a longer view.</p><a class="text-link" href="/about/">Get to know SLICKK <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="section container"><div class="section-heading"><div><p class="eyebrow">Across markets. Towards opportunity.</p><h2>International reach.<br />Considered connections.</h2></div><div><p>Exploring sourcing opportunities in three markets,<br class="desktop-break" /> with Bangladesh as our destination focus.</p><a class="text-link" href="/global-sourcing/">Explore our sourcing approach <span aria-hidden="true">↗</span></a></div></div><SourcingMap /><div class="market-strip">{markets.map((market) => <div><span>{market.code}</span><h3>{market.name}</h3><p>Sourcing market of interest</p></div>)}</div></section>
  <section class="quality-section section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Care in the details</p><h2>Fresh thinking.<br />From source to discussion.</h2></div><a class="text-link" href="/quality-logistics/">Quality & logistics <span aria-hidden="true">↗</span></a></div><div class="principles-grid"><article><span>01 / SPECIFICATION</span><h3>Clarity comes first.</h3><p>Variety, grade, size and packing. Define the requirements before comparing proposals.</p></article><article><span>02 / COORDINATION</span><h3>Consider the journey.</h3><p>Bring handling, temperature awareness and documentation into the sourcing conversation.</p></article><article><span>03 / PARTNERSHIP</span><h3>Build on transparency.</h3><p>Distinguish confirmed facts from estimates. Make commitments with care.</p></article></div><a class="text-link quality-link" href="/why-slickk/">Why SLICKK <span aria-hidden="true">↗</span></a></div></section>
  <section class="section container purpose-grid"><div><p class="eyebrow">Our purpose</p><h2>Growing toward<br />something better.</h2><a class="text-link" href="/responsible-sourcing/">Our sourcing principles <span aria-hidden="true">↗</span></a></div><div class="purpose-copy"><article><h3>Our mission</h3><p>Connect Bangladesh’s fruit market with quality fresh produce through transparent communication, responsible sourcing and efficient import coordination.</p></article><article><h3>Our vision</h3><p>Become a trusted name in Bangladesh’s fresh-fruit importing and wholesale industry through strong relationships, modern technology and a commitment to quality and reliability.</p></article></div></section>
  <section class="container partnership-grid"><a class="partnership-card" href="/for-exporters/"><span class="eyebrow">For international exporters</span><h2>A new market.<br />A shared opportunity.</h2><p>Introduce your fruit, your business and your proposed terms.</p><span class="text-link">Connect as an exporter <span aria-hidden="true">↗</span></span></a><a class="partnership-card buyer-card" href="/for-buyers/"><span class="eyebrow">For wholesale buyers</span><h2>Good sourcing starts<br />with your requirements.</h2><p>Tell us the fruit, quantity, packing and timing you have in mind.</p><span class="text-link">Make a wholesale inquiry <span aria-hidden="true">↗</span></span></a></section>
  <ContactCTA />
</Layout>
