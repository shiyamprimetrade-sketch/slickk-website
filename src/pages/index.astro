---
import Layout from '../layouts/Layout.astro';
import GradientButton from '../components/GradientButton.astro';
import { services, pricing, faqs, portfolioConcepts } from '../data/agency';
import { packageServices } from '../data/v4';
import { guides } from '../data/guides';
---
<Layout title="Creative Technology, Branding & Digital Solutions" description="Slickk Digital Solutions creates distinctive brands, corporate brochures, powerful websites, software, SEO and digital growth experiences for Bangladesh and international business clients.">
  <section class="hero flagship-hero" aria-label="Slickk Digital Solutions introduction">
    <div class="container"><div class="hero-topline"><span>Independent creative technology</span><span>Bangladesh / Working worldwide</span></div>
      <div class="hero-grid"><div class="hero-copy"><p class="eyebrow">From first impression to everyday operation</p>
        <h1>We Design.<br /><em>We Build.</em><br />We Elevate.</h1>
        <p class="lead">Brands people recognize. Websites people understand. Software that makes work simpler.</p>
        <div class="actions"><GradientButton href="/request-quote/">Start Your Project</GradientButton><a class="btn btn-outline" href="/portfolio/">Explore Our Work</a></div>
        <p class="hero-footnote">A founder-led studio. Direct collaboration. Clearly agreed scope.</p>
      </div>
      <div class="signal-board"><div class="signal-caption"><span>01 / THE SLICKK SYSTEM</span><span>DESIGN × ENGINEERING</span></div>
        <img class="signal-mark" src="/brand/slickk-symbol-blue.svg" width="420" height="420" alt="SLICKK geometric S symbol, constructed from angular cuts" fetchpriority="high" />
        <div class="signal-tabs" aria-label="Explore our approach">
          <details open name="approach"><summary><span>01</span> Make it distinct</summary><p>A useful identity stays recognizable on a small screen, a proposal and a storefront.</p></details>
          <details name="approach"><summary><span>02</span> Make it work</summary><p>Accessible pages, clear workflows and tested forms turn a visual direction into a usable product.</p></details>
          <details name="approach"><summary><span>03</span> Make it last</summary><p>Agreed source files, ownership and handover notes help you maintain what you commission.</p></details>
        </div>
      </div></div>
    </div>
  </section>
  <section class="section ivory-section" id="services"><div class="container">
    <div class="editorial-heading"><p class="eyebrow">01 / Capabilities</p><div><h2>One clear idea.<br />Many ways to make it real.</h2><p>Start with the problem your business needs to solve. Connect the right disciplines as the project grows.</p></div></div>
    <div class="service-index">{services.map((service,i)=><a class="service-row" href={'/'+service.slug+'/'}><span class="row-number">{String(i+1).padStart(2,'0')}</span><h3>{service.name}</h3><p>{service.short}</p><span class="row-arrow" aria-hidden="true">↗</span></a>)}</div>
    <div class="actions"><a class="btn btn-outline" href="/services/">Explore every service</a><a class="text-link" href="/services/brochure-design/">Need a company brochure? →</a></div>
  </div></section>
  <section class="section container" id="work"><div class="editorial-heading"><p class="eyebrow">02 / The studio laboratory</p><div><h2>See the thinking.<br />Explore the possibilities.</h2><p>Original self-initiated studies. Fictional briefs, clearly labeled. No client commissions or commercial results are implied.</p></div></div>
    <div class="selected-work">{portfolioConcepts.slice(0,3).map((concept,i)=><article class="project-tile"><a class="project-visual" href={'/portfolio/'+concept.slug+'/'}><img src={'/images/portfolio/'+concept.slug+'.svg'} width="1200" height="850" alt={concept.title+' — original self-initiated concept study'} loading="lazy" decoding="async" /></a><div class="project-meta"><span>STUDY {String(i+1).padStart(2,'0')} / {concept.eyebrow}</span><h3>{concept.title}</h3><p>{concept.summary}</p><a href={'/portfolio/'+concept.slug+'/'}>Open the study →</a></div></article>)}</div>
    <div class="actions"><GradientButton href="/portfolio/">Explore all concepts</GradientButton></div>
  </section>
  <section class="section ivory-section"><div class="container process-spread"><div><p class="eyebrow">03 / From question to handover</p><h2>Good work starts<br />with better questions.</h2><p>A solo founder leads the work. Scope, decisions and review points stay visible throughout the project.</p><a class="text-link" href="/process/">How collaboration works →</a></div><ol class="process-list"><li><h3>Understand the job.</h3><p>What should change for your customer or your team? Agree the audience, constraints and useful outcome.</p></li><li><h3>Choose a direction.</h3><p>Review a focused concept and a written scope before the work expands.</p></li><li><h3>Build and challenge it.</h3><p>Test the design against real content, small screens, keyboard access and the agreed requirements.</p></li><li><h3>Hand over with clarity.</h3><p>Receive the agreed files, ownership details and instructions. Know what support is included.</p></li></ol></div></section>
  <section class="section container"><div class="editorial-heading"><p class="eyebrow">04 / A practical starting point</p><div><h2>Clear scope.<br />Visible starting prices.</h2><p>Bangladeshi taka. Final scope, revisions, timing and exclusions are confirmed in writing.</p></div></div>
    <div class="grid cards-3 package-grid">{pricing.slice(0,3).map(item=><article class="card"><p class="card-number">Starting package</p><h3>{item.name}</h3><div class="price">{item.price}</div><p>{item.description}</p><a href={'/request-quote/?service='+packageServices[item.name]}>Discuss this scope →</a></article>)}</div><div class="actions"><a class="btn btn-outline" href="/pricing/">Compare all packages and exclusions</a></div>
  </section>
  <section class="section ivory-section"><div class="container"><div class="editorial-heading"><p class="eyebrow">05 / Before the brief</p><div><h2>Useful decisions.<br />Before you spend.</h2></div></div><div class="guide-grid">{guides.map(guide=><a class="guide-card" href={'/insights/'+guide.slug+'/'}><span class="eyebrow">{guide.readingTime}</span><h3>{guide.title}</h3><p>{guide.intro}</p><span class="text-link">Read the guide →</span></a>)}</div></div></section>
  <section class="section container faq"><div class="section-head"><p class="eyebrow">06 / Clarity upfront</p><h2>Good questions lead to better work.</h2></div>{faqs.slice(0,4).map(item=><details><summary>{item.question}</summary><p>{item.answer}</p></details>)}<div class="actions"><a href="/faq/" class="btn btn-outline">View all FAQs</a></div></section>
  <section class="section container"><div class="cta"><div><p class="eyebrow">Your next useful move</p><h2>What needs to work better?</h2><p>Bring a business problem, an unfinished idea or a clear brief. We will start there.</p></div><GradientButton href="/contact/">Request a consultation</GradientButton></div></section>
</Layout>
