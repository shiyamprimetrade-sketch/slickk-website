{
  "name": "slickk-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/security-headers.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "lint": "eslint .",
    "security:scan": "node scripts/scan-secrets.mjs",
    "test": "node --test tests/agency.test.mjs tests/leads.test.mjs tests/v4.test.mjs tests/ai.test.mjs tests/partner-growth.test.mjs",
    "test:browser": "playwright test",
    "deploy": "npm run check && npm run lint && npm run build && npm test && wrangler pages deploy dist --project-name=slickk --branch=main",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "astro": "7.4.2",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.64.1",
    "cheerio": "1.2.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "lighthouse": "13.5.0",
    "sharp": "0.35.5",
    "wrangler": "4.155.0"
  }
}
